# Copy to .env.local for local development, and add the same variables
# in Vercel → Project → Settings → Environment Variables.
# Values come from Supabase → Project Settings → API Keys / Data API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser:
# RLS decides what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) or the legacy "service_role" key. Bypasses RLS.
# Server only: never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
SUPABASE_SECRET_KEY=

# Optional: the public read-only demo account (role "demo", see schemas/demo.sql).
# When both are set, the login page shows a "Try the demo" button. These are
# shown to every visitor, so only use the demo account's credentials here.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
